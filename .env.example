# Copy this file to .env.local and fill in the values.
# Never commit .env.local. Never expose the two secret keys to the browser.

# Public URL of the site (no trailing slash). Use http://localhost:3000 while developing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SECRET: server only. Used by the Stripe webhook and free-course enrolment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe: Developers -> API keys (use test keys until you go live)
# SECRET: server only.
STRIPE_SECRET_KEY=sk_test_...
# From the webhook endpoint you create in Stripe (see README), or from `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=whsec_...
